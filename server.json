{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fyipedia/unitfyi",
  "description": "Pure Python unit conversion engine \u2014 200 units, 20 categories, Decimal precision. Zero dependencies.",
  "version": "0.1.3",
  "repository": {
    "url": "https://github.com/fyipedia/unitfyi",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "unitfyi",
      "version": "0.1.3",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "unitfyi[mcp]"
        },
        {
          "type": "positional",
          "value": "python"
        },
        {
          "type": "positional",
          "value": "-m"
        },
        {
          "type": "positional",
          "value": "unitfyi.mcp_server"
        }
      ]
    }
  ]
}
